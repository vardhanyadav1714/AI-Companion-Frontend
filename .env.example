API_BASE_URL=http://localhost:4000/api/v1
# Must match core WEB_PROXY_KEY. Ingress must overwrite X-Real-IP; do not publish
# the Next.js container port directly. Keep this variable server-side only.
WEB_PROXY_KEY=
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public web OAuth client ID; match the backend GOOGLE_CLIENT_ID. Set at build time.
GOOGLE_CLIENT_ID=
# Public legal-page details, embedded at build time. Set both before release.
EVA_LEGAL_OPERATOR_NAME=
EVA_SUPPORT_EMAIL=
